# Optional: override the OpenF1 upstream. Keep the production default otherwise.
# OPENF1_API_BASE_URL=https://api.openf1.org/v1

# Optional secrets (never prefix server-only secrets with NEXT_PUBLIC_)
# OPENF1_API_KEY=
# NEWS_API_KEY=
# YOUTUBE_API_KEY=

# Optional distributed API rate limiter (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# FORMULA_API_RATE_LIMIT=90
